// Measures on the Customers table, in the Dashboard KPIs display folder.
// This file documents the measures already included in the PBIX.
// To recreate them manually, add each expression separately as a new measure.

// Display format: #,0
Total Customers = COUNTROWS(Customers)

// Display format: #,0
Churned Customers = COALESCE(SUM(Customers[Churn]), 0)

// Display format: #,0
Existing Customers = [Total Customers] - [Churned Customers]

// Display format: 0.00%
Churn Rate = DIVIDE([Churned Customers], [Total Customers])

// Display format: 0.0
Average Transactions = AVERAGE(Customers[Total_Trans_Ct])

// Display format: 0.0%
Average Utilization = AVERAGE(Customers[Avg_Utilization_Ratio])
